# ── Socia env template ────────────────────────────────────────────────────
# Copy these keys into your Replit Secrets pane (or a local .env for self-host)
# so Vite can inject them at build time. Anything VITE_-prefixed is shipped to
# the browser, so DO NOT put server-only secrets here.

# ── Supabase (required) ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── WebRTC TURN (required for cross-network calls) ───────────────────────
# Without TURN, calls between strict NATs (WiFi ↔ mobile data, corp ↔ home,
# many carrier-grade NATs) will hang on "Connecting…".
#
# Cloudflare Realtime TURN (free tier available):
#   1. https://dash.cloudflare.com/  →  Realtime  →  TURN
#   2. Create an app → "Generate credentials"
#   3. Paste the returned values below.
#
# You can pass multiple TURN URLs as a comma-separated list (TLS preferred):
#   VITE_TURN_URL=turn:turn.cloudflare.com:3478,turns:turn.cloudflare.com:5349
VITE_TURN_URL=turn:turn.cloudflare.com:3478
VITE_TURN_USERNAME=YOUR_CLOUDFLARE_TURN_USERNAME
VITE_TURN_CREDENTIAL=YOUR_CLOUDFLARE_TURN_PASSWORD
